# CinePulse AI Environment Configuration Template
# Copy this file to .env and insert your personal API keys

# TMDB API (The Movie Database) - Bearer Read Access Token or API Key v3
# Obtain at: https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=your_tmdb_api_key_or_token_here

# Google Gemini API Key - For AI Cinephile Neural Engine
# Obtain at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# OMDB API Key (Optional) - For Box Office metadata
# Obtain at: https://www.omdbapi.com/apikey.aspx
VITE_OMDB_API_KEY=your_omdb_api_key_here

# Supabase Configuration - For Authentication & Cloud Watchlist
# Obtain at: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Scraper Backend Microservice Port
PORT=5000
