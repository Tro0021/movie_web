{
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/box-office.js": { "maxDuration": 10 },
    "api/financials/[imdbId].js": { "maxDuration": 10 },
    "api/imdb/[imdbId].js": { "maxDuration": 10 },
    "api/media/resolve.js": { "maxDuration": 10 },
    "api/movies.js": { "maxDuration": 5 },
    "api/health.js": { "maxDuration": 5 }
  }
}
